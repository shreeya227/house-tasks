# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead.

# Neon connection string, in the normal postgres:// form (NOT jdbc:).
# Use the "Pooled connection" string from Neon (host contains -pooler).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Same pair you used on Render, so nobody has to re-enable notifications.
# New pair: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Signs the person tokens. openssl rand -base64 32
TOKEN_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/weekly.
# openssl rand -base64 32
CRON_SECRET=
